{
  "name": "@wishalia/web-public",
  "version": "0.0.8",
  "private": true,
  "type": "module",
  "imports": {
    "#lib": "./src/lib",
    "#lib/*": "./src/lib/*"
  },
  "description": "Public view of the share links (<product>.<domain>).",
  "files": [
    "build"
  ],
  "scripts": {
    "dev": "vite dev --port 3002",
    "build": "vite build",
    "preview": "vite preview",
    "start": "node build",
    "lint": "eslint .",
    "typecheck": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "vitest run"
  },
  "dependencies": {
    "@wishalia/domain": "workspace:*",
    "@wishalia/i18n": "workspace:*",
    "@wishalia/metrics": "workspace:*",
    "@wishalia/storage": "workspace:*"
  },
  "devDependencies": {
    "@sveltejs/adapter-node": "^6.0.5",
    "@sveltejs/kit": "^3.4.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.11",
    "@wishalia/ui": "workspace:*",
    "svelte": "^5.59.1",
    "svelte-check": "^4.7.8",
    "vite": "^8.3.8"
  }
}
