{
  "extends": "$app/tsconfig",
  "compilerOptions": {
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true,
    "types": ["$app/types", "node"]
  },
  "include": ["src", "test", "*"],
  "exclude": ["src/service-worker"]
}
