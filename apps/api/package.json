{
  "name": "@wishlist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: /manage/* for the owner, /public/* for the share links.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../../.env src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@better-auth/passkey": "^1.7.27",
    "@fastify/helmet": "^13.2.0",
    "@wishlist/db": "workspace:*",
    "@wishlist/domain": "workspace:*",
    "@wishlist/metrics": "workspace:*",
    "better-auth": "^1.7.27",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "nodemailer": "^10.6.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.17",
    "@types/node": "^24.19.2",
    "@types/nodemailer": "^8.0.2",
    "@wishlist/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
