{
  "name": "@wishlist/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Fastify API: /manage/* for the owner, /public/* for the share links.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/helmet": "^13.2.0",
    "@wishlist/db": "workspace:*",
    "@wishlist/domain": "workspace:*",
    "fastify": "^5.12.8",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@wishlist/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
