    "@wishalia/metrics": "workspace:*",
    "@wishalia/storage": "workspace:*",
    "drizzle-orm": "^0.45.4"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@wishalia/config": "workspace:*",
    "tsx": "^4.23.15"
  }
}
