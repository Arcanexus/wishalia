{
  "name": "@wishalia/worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Background jobs: completing items from their link, their images included (queue in PostgreSQL), price tracking to come.",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json",
