# Copy to .env for local development. Never commit .env.
DATABASE_URL=postgres://wishalia:wishalia@localhost:5432/wishalia
APP_NAME=Wishalia
# Images in Garage (docker compose). On a folder instead: IMAGE_STORAGE=volume, IMAGE_DIR=/abs/path
# (and imgproxy with IMGPROXY_LOCAL_FILESYSTEM_ROOT on the same folder, docs/images.md)
S3_ENDPOINT=http://localhost:9000
S3_ACCESS_KEY=GK6c6f63616c2d6f6e6c792d6b65792121
S3_SECRET_KEY=6c6f63616c2d6f6e6c792d6761726167652d7365637265742d6368616e676521
S3_BUCKET=wishalia
# imgproxy (docker compose) signs and reads with these; local values only (openssl rand -hex 32)
IMGPROXY_KEY=6c6f63616c2d6f6e6c792d696d6770726f78792d6b65792d6368616e67652d6d65
IMGPROXY_SALT=6c6f63616c2d6f6e6c792d696d6770726f78792d73616c742d6368616e67652d
IMGPROXY_URL=http://localhost:8081

# Sign-in. In development the magic links are printed in the API log instead of being emailed.
OWNER_EMAILS=you@example.com
# 32+ random characters (openssl rand -base64 32). Unset: sessions end when the API restarts.
AUTH_SECRET=
# Optional: your OIDC provider (Authelia, Authentik, Keycloak...)
OIDC_ISSUER=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
