{
  "name": "@wishalia/i18n",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "The languages of Wishalia: which one a person reads, the words of every screen and email, and dates and amounts in their language.",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./messages/*": {
      "types": "./dist/messages/*.d.ts",
      "default": "./dist/messages/*.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@types/node": "^26.6.11",
    "@wishalia/config": "workspace:*"
  }
}
