{
  "name": "@wishalia/ui",
  "version": "0.0.7",
  "private": true,
  "type": "module",
  "description": "What the two frontends share: the design tokens and base styles, the fonts, the logo (docs/branding.md), and the drawings and words of the public view.",
  "exports": {
    "./styles.css": "./src/styles.css",
    "./Logo.svelte": {
      "svelte": "./src/Logo.svelte",
      "default": "./src/Logo.svelte"
    },
    "./public/*.svelte": {
      "svelte": "./src/public/*.svelte",
      "default": "./src/public/*.svelte"
    },
    "./public/*.ts": "./src/public/*.ts",
    "./i18n.ts": "./src/i18n.ts",
    "./gallery.ts": "./src/gallery.ts",
    "./Gallery.svelte": {
      "svelte": "./src/Gallery.svelte",
      "default": "./src/Gallery.svelte"
    },
    "./LanguageButtons.svelte": {
      "svelte": "./src/LanguageButtons.svelte",
      "default": "./src/LanguageButtons.svelte"
    },
    "./live.ts": "./src/live.ts",
    "./StageIcon.svelte": {
      "svelte": "./src/StageIcon.svelte",
      "default": "./src/StageIcon.svelte"
    },
    "./Icon.svelte": {
      "svelte": "./src/Icon.svelte",
      "default": "./src/Icon.svelte"
    },
    "./Menu.svelte": {
      "svelte": "./src/Menu.svelte",
      "default": "./src/Menu.svelte"
    },
    "./DisplayMenu.svelte": {
      "svelte": "./src/DisplayMenu.svelte",
      "default": "./src/DisplayMenu.svelte"
    },
    "./icons.ts": "./src/icons.ts",
    "./HeaderLink.svelte": {
      "svelte": "./src/HeaderLink.svelte",
      "default": "./src/HeaderLink.svelte"
    },
    "./ListBadge.svelte": {
      "svelte": "./src/ListBadge.svelte",
      "default": "./src/ListBadge.svelte"
    },
    "./list-icons.ts": "./src/list-icons.ts"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/nunito": "^5.3.0",
    "@wishalia/domain": "workspace:*",
    "@wishalia/i18n": "workspace:*"
  },
  "peerDependencies": {
    "svelte": "^5.59.1"
  },
  "scripts": {
    "lint": "eslint .",
    "test": "vitest run"
  }
}
