{
  "name": "@wishlist/db",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Drizzle schema, migrations and the PostgreSQL client.",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.4",
    "postgres": "^4.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@wishlist/config": "workspace:*",
    "drizzle-kit": "^0.31.11"
  }
}
